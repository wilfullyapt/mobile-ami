[Unit]
Description=Local AI Voice Assistant
After=network.target hailo.service ollama.service
Wants=ollama.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/mobile-ami
ExecStart=/usr/bin/python3 /home/pi/mobile-ami/cli.py run
Environment="PYTHONUNBUFFERED=1"
Environment="OLLAMA_MODELS=/home/pi/.amini/models/llm"
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
